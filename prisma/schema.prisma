// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  balance     Float        @default(0) // New Wallet Balance
  createdAt   DateTime     @default(now())
  credentials Credential[]
  transactions Transaction[]
  withdrawals Withdrawal[]
}

model Withdrawal {
  id            String   @id @default(cuid())
  amount        Float
  status        String   @default("pending") // pending, approved, rejected
  bankName      String
  accountNumber String
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Credential {
  id           String   @id @default(cuid())
  externalId   String   @unique // The Credential ID
  publicKey    Bytes
  signCount    Int
  transports   String?  // JSON string
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  createdAt    DateTime @default(now())
}

model Transaction {
  id           String   @id @default(cuid())
  item         String
  amount       Float
  fee          Float
  status       String   @default("pending") // pending, paid, completed
  creatorEmail String
  targetEmail  String
  role         String   // "buyer" or "seller" (role of the creator)
  paymentRef   String?  // ToyyibPay billCode
  
  creator      User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId    String
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id           String   @id @default(cuid())
  timestamp    DateTime @default(now())
  userEmail    String
  event        String
  previousHash String
  hash         String
}

model AuthChallenge {
  id        String   @id @default(cuid())
  challenge String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())
  used       Boolean  @default(false)

  @@index([identifier])
}

model RequestNonce {
  id        String   @id @default(cuid())
  nonce     String   @unique
  userId    String
  endpoint  String
  usedAt    DateTime @default(now())
  expiresAt DateTime
}
